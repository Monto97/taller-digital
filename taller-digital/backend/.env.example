NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=taller123
DB_NAME=taller_digital

# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URL del front: se usa para armar los links que recibe el cliente por WhatsApp
PUBLIC_APP_URL=http://localhost:4200
# Orígenes permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:4200

# Opcional. Si la definís, POST /api/auth/registro exige el header X-Clave-Registro con este valor.
# En producción, sin esta variable el registro queda cerrado.
# REGISTRO_CLAVE=

# Opcional. Carpeta con el build de Angular para que la API también sirva el frontend (lo usa el Dockerfile).
# FRONTEND_DIST=../frontend/dist/frontend/browser

# Credenciales de la aplicación de Mercado Pago (Tus integraciones → tu app → Credenciales de producción).
# Si están vacías, el módulo de MP responde "no configurado" y no se puede conectar ningún taller.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Opcional. URL a la que MP devuelve el `code` tras autorizar. Debe estar registrada en el app de MP.
# Si no se define, se arma desde PUBLIC_APP_URL (ej: https://tu-app/api/mp/oauth/callback).
# MP_REDIRECT_URI=
# Opcional. Secreto para validar la firma del webhook (header x-signature). En producción conviene cargarlo.
# MP_WEBHOOK_SECRET=
